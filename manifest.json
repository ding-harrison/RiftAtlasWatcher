{
  "manifest_version": 3,
  "name": "RiftAtlas Full Log Keeper",
  "short_name": "Log Keeper",
  "version": "1.0.1",
  "description": "Keeps every game-log line from play.riftatlas.com, with one-click export and match recording. Everything stays on your computer.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["storage", "unlimitedStorage", "tabCapture", "offscreen", "downloads"],
  "host_permissions": ["https://play.riftatlas.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://play.riftatlas.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "RiftAtlas Full Log Keeper",
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-recording": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Start / stop recording the RiftAtlas tab"
    }
  }
}
